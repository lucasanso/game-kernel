#include <windows.h>
#pragma code_page(65001)

1 VERSIONINFO
FILEVERSION 1,2,3,4
PRODUCTVERSION 1,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Game Kernel Test Corpus"
            VALUE "FileDescription", "Programa de teste com acentuação"
            VALUE "FileVersion", "1.2.3.4"
            VALUE "InternalName", "resources"
            VALUE "OriginalFilename", "resources.exe"
            VALUE "ProductName", "GK Corpus"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 RT_MANIFEST "manifest.xml"
100 RCDATA "embedded.bin"
PAYLOAD BINDATA "noise.bin"
STRINGTABLE
BEGIN
    1 "Game Kernel"
END
